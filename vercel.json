{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "version": 2,
  "env": {
    "GROWTH_PUBLIC_URL": "https://uucjptyqfsdzqsftgiro.supabase.co/functions/v1/growth-proxy",
    "BOT_USERNAME": "junior_jobs_channel_bot"
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/api/webhook-admin",
      "destination": "/api/webhook_admin"
    },
    {
      "source": "/api/channel-launch",
      "destination": "/api/channel_launch"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py,fixtures/**,__fixtures__/**,testdata/**,sample-data/**,static/**,assets/**}"
    }
  }
}
